  type Root = ({
    code: string;
    content: {
      internal_comment: null;
      outline: string | null;
    };
    day: {
      date: string;
      day_name: string;
      id: number;
    };
    duration: number;
    id: number;
    is_published: boolean;
    livestream_url?: string;
    order: null;
    parent_id: number | null;
    room: {
      capacity: number;
      id: number;
      name: string;
    };
    session_type: {
      id: number;
      name: string;
    };
    speakers: ({
      affiliation: string | null;
      id: number;
      name: string;
    })[];
    tags: string[];
    technical_equipment: null;
    title: string;
  })[];
  '''
# ---
# name: test_typescript_with_cardinality
  '''
  type Root = ({
    code: 'S-101' | 'S-102' | 'S-103' | 'S-104' | 'S-105';
    content: {
      internal_comment: null;
      outline: '<p>A survey of the field, with pointers to open problems.</p>' | '<p>Hands-on session. Bring a laptop.</p>' | '<p>Informal.</p>' | '<p>Thanks, and see you next year.</p>' | null;
    };
    day: {
      date: '2026-05-04' | '2026-05-05' | '2026-05-06';
      day_name: 'Monday' | 'Tuesday' | 'Wednesday';
      id: 1 | 2 | 3;
    };
    duration: number;
    id: 101 | 102 | 103 | 104 | 105;
    is_published: boolean;
    livestream_url?: 'https://example.org/live/104';
    order: null;
    parent_id: 103 | null;
    room: {
      capacity: 120 | 200 | 800;
      id: 1 | 2 | 3;
      name: 'HALL A' | 'HALL B' | 'HALL C';
    };
    session_type: {
      id: 1 | 2 | 3 | 4;
      name: 'Plenary' | 'Special Interest' | 'Symposium' | 'Workshop';
    };
    speakers: ({
      affiliation: 'Independent' | 'Institute of Fine Structures' | 'Northfield University' | null;
      id: 11 | 12 | 13 | 14;
      name: 'A. Rivera' | 'B. Okonkwo' | 'C. Lindqvist' | 'D. Ferreira';
    })[];
    tags: ('closing' | 'hands-on' | 'informal' | 'keynote' | 'lunch' | 'overview')[];
    technical_equipment: null;
    title: 'Closing Remarks' | 'Opening Plenary: The State of Inference' | 'Special Interest: Tokenizer Trivia' | 'Symposium: Schema Drift' | 'Workshop: Streaming Parsers in Practice';
  })[];
  '''
# ---
# name: test_yaml
  '''
  - code: string
    content:
      internal_comment: null
      outline: string | null
    day:
      date: string
      day_name: string
      id: integer
    duration: number
    id: integer
    is_published: boolean
    livestream_url?: string
    order: null
    parent_id: integer | null
    room:
      capacity: integer
      id: integer
      name: string
    session_type:
      id: integer
      name: string
    speakers:
      - affiliation: string | null
        id: integer
        name: string
