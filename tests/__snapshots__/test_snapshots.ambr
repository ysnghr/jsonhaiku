# name: test_typescript
  '''
  type Root = ({
    code: string;
    content: {
      internal_comment: null;
      outline: string | null;
    };
    day: {
      date: string;
      day_name: string;
      id: number;
    };
    duration: number;
    id: number;
    is_published: boolean;
    livestream_url?: string;
    order: null;
    parent_id: number | null;
    room: {
      capacity: number;
      id: number;
      name: string;
    };
    session_type: {
      id: number;
      name: string;
    };
    speakers: ({
      affiliation: string | null;
      id: number;
      name: string;
    })[];
    tags: string[];
    technical_equipment: null;
    title: string;
  })[];
  '''
