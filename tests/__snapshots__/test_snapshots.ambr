# name: test_compact_with_cardinality
  '''
  [{
    "code": "enum('S-101' | 'S-102' | 'S-103' | 'S-104' | 'S-105')",
    "content": {
      "internal_comment": "always_null",
      "outline": "enum('<p>A survey of the field, with pointers to open problems.</p>' | '<p>Hands-on session. Bring a laptop.</p>' | '<p>Informal.</p>' | '<p>Thanks, and see you next year.</p>' | null)"
    },
    "day": {
      "date": "enum('2026-05-04' | '2026-05-05' | '2026-05-06')",
      "day_name": "enum('Monday' | 'Tuesday' | 'Wednesday')",
      "id": "enum(1 | 2 | 3)"
    },
    "duration": "number (min=30, max=240, mean=105.10)",
    "id": "enum(101 | 102 | 103 | 104 | 105)",
    "is_published": "boolean",
    "livestream_url": "enum('https://example.org/live/104') | undefined",
    "order": "always_null",
    "parent_id": "enum(103 | null)",
    "room": {
      "capacity": "enum(120 | 200 | 800)",
      "id": "enum(1 | 2 | 3)",
      "name": "enum('HALL A' | 'HALL B' | 'HALL C')"
    },
    "session_type": {
      "id": "enum(1 | 2 | 3 | 4)",
      "name": "enum('Plenary' | 'Special Interest' | 'Symposium' | 'Workshop')"
    },
    "speakers": [{
      "affiliation": "enum('Independent' | 'Institute of Fine Structures' | 'Northfield University' | null)",
      "id": "enum(11 | 12 | 13 | 14)",
      "name": "enum('A. Rivera' | 'B. Okonkwo' | 'C. Lindqvist' | 'D. Ferreira')"
    }],
    "tags": ["enum('closing' | 'hands-on' | 'informal' | 'keynote' | 'lunch' | 'overview')"],
    "technical_equipment": "always_null",
    "title": "enum('Closing Remarks' | 'Opening Plenary: The State of Inference' | 'Special Interest: Tokenizer Trivia' | 'Symposium: Schema Drift' | 'Workshop: Streaming Parsers in Practice')"
  }]
  '''
