# name: test_yaml
  '''
  - code: string
    content:
      internal_comment: null
      outline: string | null
    day:
      date: string
      day_name: string
      id: integer
    duration: number
    id: integer
    is_published: boolean
    livestream_url?: string
    order: null
    parent_id: integer | null
    room:
      capacity: integer
      id: integer
      name: string
    session_type:
      id: integer
      name: string
    speakers:
      - affiliation: string | null
        id: integer
        name: string
    tags:     - string
    technical_equipment: null
    title: string
  '''
